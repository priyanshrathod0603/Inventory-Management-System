# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sms_db?schema=public"

# Backend API Configuration
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
SESSION_SECRET="change-this-to-a-secure-random-64-character-secret-in-production"
SESSION_EXPIRY_DAYS=30

# Google OAuth 2.0 Configuration
# Required for BOTH the authorization-code redirect flow AND the ID token flow.
# Get these from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Email Delivery — Gmail SMTP
# Provider: Gmail SMTP (smtp.gmail.com)
# Auth: Gmail App Password (NOT your normal Gmail password)
# How to generate a Gmail App Password:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a password for "Mail" > "Other device" > name it "SMS"
#   4. Copy the 16-character app password and paste it into SMTP_PASS below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS=""
EMAIL_FROM="Stock Management System <your-gmail-address@gmail.com>"

# Frontend URL (used in email verification links and OAuth redirect)
FRONTEND_URL="http://localhost:3000"

# Redis Configuration (Cache / Sessions / Queues)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Frontend Configuration (for web app .env.local)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
