# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sms_db?schema=public"

# Backend API Configuration
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
SESSION_SECRET="change-this-to-a-secure-random-64-character-secret-in-production"
SESSION_EXPIRY_DAYS=30

# Email Verification & SMTP Delivery (Resend / Custom SMTP)
EMAIL_FROM="Stock Management System <noreply@example.com>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS=""
FRONTEND_URL="http://localhost:3000"

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Redis Configuration (Cache / Sessions / Queues)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
