datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Authentication & RBAC
// -------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  roleId       String    @db.Uuid
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  lastLoginAt  DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz

  role               Role                @relation(fields: [roleId], references: [id])
  sessions           Session[]
  sales              Sale[]
  purchases          Purchase[]
  salesReturns       SalesReturn[]
  purchaseReturns    PurchaseReturn[]
  paymentsReceived   Payment[]
  stockMovements     StockMovement[]
  stockAdjustments   StockAdjustment[]
  stockTransfers     StockTransfer[]
  cancelledInvoices  Invoice[]           @relation("InvoiceCancelledBy")
  heldBills          HeldBill[]
  cashDrawerSessions CashDrawerSession[]
  auditLogs          AuditLog[]
  settingsUpdated    SystemSetting[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String? @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @db.VarChar(128)
  userId    String   @db.Uuid
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// -------------------------------------------------------------
// Master Data: Products, Categories, Brands & Warehouses
// -------------------------------------------------------------

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  parentId    String?  @db.Uuid
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz

  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]

  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz

  products Product[]

  @@map("brands")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(255)
  sku              String   @unique @db.VarChar(100)
  barcode          String?  @unique @db.VarChar(100)
  categoryId       String   @db.Uuid
  brandId          String?  @db.Uuid
  unit             String   @db.VarChar(20)
  purchasePrice    Decimal  @default(0.00) @db.Decimal(12, 2)
  sellingPrice     Decimal  @default(0.00) @db.Decimal(12, 2)
  mrp              Decimal  @default(0.00) @db.Decimal(12, 2)
  taxRate          Decimal  @default(0.00) @db.Decimal(5, 2)
  isTaxInclusive   Boolean  @default(true)
  minStockAlert    Decimal  @default(5.000) @db.Decimal(10, 3)
  currentStock     Decimal  @default(0.000) @db.Decimal(10, 3)
  hasBatchTracking Boolean  @default(false)
  isActive         Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz

  category            Category             @relation(fields: [categoryId], references: [id])
  brand               Brand?               @relation(fields: [brandId], references: [id])
  warehouseInventory WarehouseInventory[]
  batches             ProductBatch[]
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  salesReturnItems    SalesReturnItem[]
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[]
  stockTransferItems  StockTransferItem[]

  @@index([sku])
  @@index([barcode])
  @@map("products")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  address   String?  @db.Text
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  warehouseInventory WarehouseInventory[]
  batches            ProductBatch[]
  sales              Sale[]
  purchases          Purchase[]
  salesReturns       SalesReturn[]
  purchaseReturns    PurchaseReturn[]
  stockMovements     StockMovement[]
  stockAdjustments   StockAdjustment[]
  transfersFrom      StockTransfer[]      @relation("TransferFromWarehouse")
  transfersTo        StockTransfer[]      @relation("TransferToWarehouse")

  @@map("warehouses")
}

model WarehouseInventory {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @db.Uuid
  productId   String   @db.Uuid
  quantity    Decimal  @default(0.000) @db.Decimal(10, 3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("warehouse_inventory")
}

model ProductBatch {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  warehouseId   String   @db.Uuid
  batchNumber   String   @db.VarChar(100)
  mfgDate       DateTime? @db.Date
  expiryDate    DateTime  @db.Date
  quantity      Decimal   @default(0.000) @db.Decimal(10, 3)
  purchasePrice Decimal   @db.Decimal(12, 2)
  status        String    @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz

  product        Product         @relation(fields: [productId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([expiryDate])
  @@map("product_batches")
}

// -------------------------------------------------------------
// CRM & Vendor Master: Customers & Suppliers
// -------------------------------------------------------------

model Customer {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(150)
  phone              String?  @unique @db.VarChar(20)
  email              String?  @db.VarChar(255)
  address            String?  @db.Text
  gstin              String?  @db.VarChar(20)
  creditLimit        Decimal  @default(0.00) @db.Decimal(12, 2)
  outstandingBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  isWalkIn           Boolean  @default(false)
  isActive           Boolean  @default(true)
  isDeleted          Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz

  sales        Sale[]
  salesReturns SalesReturn[]
  ledger       CustomerLedger[]
  heldBills    HeldBill[]

  @@index([phone])
  @@map("customers")
}

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  companyName     String   @db.VarChar(200)
  contactPerson   String?  @db.VarChar(100)
  phone           String   @db.VarChar(20)
  email           String?  @db.VarChar(255)
  address         String?  @db.Text
  gstin           String?  @db.VarChar(20)
  pendingPayables Decimal  @default(0.00) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz

  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  ledger          SupplierLedger[]

  @@map("suppliers")
}

model CustomerLedger {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  transactionDate DateTime @db.Timestamptz
  referenceType   String   @db.VarChar(50)
  referenceId     String   @db.Uuid
  referenceNumber String   @db.VarChar(100)
  debitAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  creditAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  runningBalance  Decimal  @db.Decimal(12, 2)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, transactionDate])
  @@map("customer_ledger")
}

model SupplierLedger {
  id              String   @id @default(uuid()) @db.Uuid
  supplierId      String   @db.Uuid
  transactionDate DateTime @db.Timestamptz
  referenceType   String   @db.VarChar(50)
  referenceId     String   @db.Uuid
  referenceNumber String   @db.VarChar(100)
  debitAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  creditAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  runningBalance  Decimal  @db.Decimal(12, 2)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, transactionDate])
  @@map("supplier_ledger")
}

// -------------------------------------------------------------
// POS, Sales, Invoicing & Held Bills
// -------------------------------------------------------------

model Sale {
  id                   String   @id @default(uuid()) @db.Uuid
  invoiceNumber        String   @unique @db.VarChar(100)
  customerId           String   @db.Uuid
  warehouseId          String   @db.Uuid
  userId               String   @db.Uuid
  saleDate             DateTime @db.Timestamptz
  subtotal             Decimal  @db.Decimal(12, 2)
  itemDiscountTotal    Decimal  @default(0.00) @db.Decimal(12, 2)
  orderDiscountAmount  Decimal  @default(0.00) @db.Decimal(12, 2)
  orderDiscountPercent Decimal  @default(0.00) @db.Decimal(5, 2)
  taxAmount            Decimal  @default(0.00) @db.Decimal(12, 2)
  cgstAmount           Decimal  @default(0.00) @db.Decimal(12, 2)
  sgstAmount           Decimal  @default(0.00) @db.Decimal(12, 2)
  igstAmount           Decimal  @default(0.00) @db.Decimal(12, 2)
  grandTotal           Decimal  @db.Decimal(12, 2)
  paidAmount           Decimal  @default(0.00) @db.Decimal(12, 2)
  changeAmount         Decimal  @default(0.00) @db.Decimal(12, 2)
  dueAmount            Decimal  @default(0.00) @db.Decimal(12, 2)
  paymentStatus        String   @db.VarChar(30)
  saleStatus           String   @default("COMPLETED") @db.VarChar(30)
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz

  customer     Customer      @relation(fields: [customerId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  items        SaleItem[]
  invoice      Invoice?
  salesReturns SalesReturn[]

  @@index([saleDate])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id                String  @id @default(uuid()) @db.Uuid
  saleId            String  @db.Uuid
  productId         String  @db.Uuid
  batchId           String? @db.Uuid
  quantity          Decimal @db.Decimal(10, 3)
  unitPrice         Decimal @db.Decimal(12, 2)
  costPriceSnapshot Decimal @db.Decimal(12, 2)
  discountAmount    Decimal @default(0.00) @db.Decimal(12, 2)
  taxRate           Decimal @default(0.00) @db.Decimal(5, 2)
  taxAmount         Decimal @default(0.00) @db.Decimal(12, 2)
  lineTotal         Decimal @db.Decimal(12, 2)

  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  batch            ProductBatch?     @relation(fields: [batchId], references: [id])
  salesReturnItems SalesReturnItem[]

  @@map("sale_items")
}

model Invoice {
  id                 String    @id @default(uuid()) @db.Uuid
  invoiceNumber      String    @unique @db.VarChar(100)
  saleId             String    @unique @db.Uuid
  invoiceDate        DateTime  @db.Timestamptz
  formatType         String    @default("80MM") @db.VarChar(20)
  pdfUrl             String?   @db.Text
  isCancelled        Boolean   @default(false)
  cancelledAt        DateTime? @db.Timestamptz
  cancelledBy        String?   @db.Uuid
  cancellationReason String?   @db.Text
  createdAt          DateTime  @default(now()) @db.Timestamptz

  sale        Sale  @relation(fields: [saleId], references: [id])
  canceller   User? @relation("InvoiceCancelledBy", fields: [cancelledBy], references: [id])

  @@index([invoiceNumber])
  @@map("invoices")
}

model HeldBill {
  id            String   @id @default(uuid()) @db.Uuid
  referenceCode String   @db.VarChar(50)
  userId        String   @db.Uuid
  customerId    String?  @db.Uuid
  cartPayload   Json     @db.JsonB
  createdAt     DateTime @default(now()) @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("held_bills")
}

// -------------------------------------------------------------
// Procurement & Purchases
// -------------------------------------------------------------

model Purchase {
  id                     String   @id @default(uuid()) @db.Uuid
  purchaseNumber         String   @unique @db.VarChar(100)
  supplierInvoiceNumber  String   @db.VarChar(100)
  supplierId             String   @db.Uuid
  warehouseId            String   @db.Uuid
  userId                 String   @db.Uuid
  purchaseDate           DateTime @db.Date
  subtotal               Decimal  @db.Decimal(12, 2)
  taxAmount              Decimal  @default(0.00) @db.Decimal(12, 2)
  discountAmount         Decimal  @default(0.00) @db.Decimal(12, 2)
  grandTotal             Decimal  @db.Decimal(12, 2)
  paidAmount             Decimal  @default(0.00) @db.Decimal(12, 2)
  paymentStatus          String   @db.VarChar(30)
  receivingStatus        String   @default("RECEIVED") @db.VarChar(30)
  notes                  String?  @db.Text
  createdAt              DateTime @default(now()) @db.Timestamptz
  updatedAt              DateTime @default(now()) @updatedAt @db.Timestamptz

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  items           PurchaseItem[]
  purchaseReturns PurchaseReturn[]

  @@index([purchaseNumber])
  @@map("purchases")
}

model PurchaseItem {
  id            String    @id @default(uuid()) @db.Uuid
  purchaseId    String    @db.Uuid
  productId     String    @db.Uuid
  batchNumber   String?   @db.VarChar(100)
  expiryDate    DateTime? @db.Date
  quantity      Decimal   @db.Decimal(10, 3)
  purchasePrice Decimal   @db.Decimal(12, 2)
  taxRate       Decimal   @default(0.00) @db.Decimal(5, 2)
  taxAmount     Decimal   @default(0.00) @db.Decimal(12, 2)
  lineTotal     Decimal   @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// -------------------------------------------------------------
// Sales Returns & Purchase Returns
// -------------------------------------------------------------

model SalesReturn {
  id                 String   @id @default(uuid()) @db.Uuid
  returnNumber       String   @unique @db.VarChar(100)
  saleId             String   @db.Uuid
  customerId         String   @db.Uuid
  warehouseId        String   @db.Uuid
  userId             String   @db.Uuid
  returnDate         DateTime @db.Timestamptz
  totalRefundAmount  Decimal  @db.Decimal(12, 2)
  refundMethod       String   @db.VarChar(30)
  reason             String   @db.VarChar(255)
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @db.Timestamptz

  sale      Sale              @relation(fields: [saleId], references: [id])
  customer  Customer          @relation(fields: [customerId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  items     SalesReturnItem[]

  @@map("sales_returns")
}

model SalesReturnItem {
  id               String  @id @default(uuid()) @db.Uuid
  salesReturnId    String  @db.Uuid
  saleItemId       String  @db.Uuid
  productId        String  @db.Uuid
  returnedQuantity Decimal @db.Decimal(10, 3)
  unitPrice        Decimal @db.Decimal(12, 2)
  refundAmount     Decimal @db.Decimal(12, 2)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem    @relation(fields: [saleItemId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@map("sales_return_items")
}

model PurchaseReturn {
  id                String   @id @default(uuid()) @db.Uuid
  returnNumber      String   @unique @db.VarChar(100)
  purchaseId        String   @db.Uuid
  supplierId        String   @db.Uuid
  warehouseId       String   @db.Uuid
  userId            String   @db.Uuid
  returnDate        DateTime @db.Timestamptz
  totalDebitAmount  Decimal  @db.Decimal(12, 2)
  reason            String   @db.VarChar(255)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz

  purchase  Purchase  @relation(fields: [purchaseId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("purchase_returns")
}

// -------------------------------------------------------------
// Payments & Cash Register Sessions
// -------------------------------------------------------------

model Payment {
  id                   String   @id @default(uuid()) @db.Uuid
  paymentNumber        String   @unique @db.VarChar(100)
  paymentType          String   @db.VarChar(30)
  referenceType        String   @db.VarChar(50)
  referenceId          String   @db.Uuid
  partyType            String   @db.VarChar(20)
  partyId              String?  @db.Uuid
  paymentMethod        String   @db.VarChar(30)
  amount               Decimal  @db.Decimal(12, 2)
  transactionReference String?  @db.VarChar(100)
  paymentDate          DateTime @db.Timestamptz
  receivedBy           String   @db.Uuid
  status               String   @default("COMPLETED") @db.VarChar(20)
  createdAt            DateTime @default(now()) @db.Timestamptz

  receiver User @relation(fields: [receivedBy], references: [id])

  @@index([paymentNumber])
  @@map("payments")
}

model CashDrawerSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  openedAt            DateTime  @db.Timestamptz
  closedAt            DateTime? @db.Timestamptz
  openingBalance      Decimal   @db.Decimal(12, 2)
  expectedCashBalance Decimal   @default(0.00) @db.Decimal(12, 2)
  actualCashCounted   Decimal?  @db.Decimal(12, 2)
  discrepancy         Decimal?  @db.Decimal(12, 2)
  status              String    @default("OPEN") @db.VarChar(20)

  user User @relation(fields: [userId], references: [id])

  @@map("cash_drawer_sessions")
}

// -------------------------------------------------------------
// Immutable Inventory Ledger, Adjustments & Transfers
// -------------------------------------------------------------

model StockMovement {
  id              String   @id @default(uuid()) @db.Uuid
  movementDate    DateTime @default(now()) @db.Timestamptz
  productId       String   @db.Uuid
  warehouseId     String   @db.Uuid
  batchId         String?  @db.Uuid
  movementType    String   @db.VarChar(30)
  quantity        Decimal  @db.Decimal(10, 3)
  beforeStock     Decimal  @db.Decimal(10, 3)
  afterStock      Decimal  @db.Decimal(10, 3)
  referenceType   String   @db.VarChar(50)
  referenceId     String   @db.Uuid
  referenceNumber String   @db.VarChar(100)
  userId          String   @db.Uuid
  reason          String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz

  product   Product       @relation(fields: [productId], references: [id])
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  batch     ProductBatch? @relation(fields: [batchId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@index([productId, movementDate])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockAdjustment {
  id               String   @id @default(uuid()) @db.Uuid
  adjustmentNumber String   @unique @db.VarChar(100)
  warehouseId      String   @db.Uuid
  productId        String   @db.Uuid
  adjustmentType   String   @db.VarChar(20)
  quantity         Decimal  @db.Decimal(10, 3)
  previousStock    Decimal  @db.Decimal(10, 3)
  newStock         Decimal  @db.Decimal(10, 3)
  reasonCategory   String   @db.VarChar(100)
  notes            String   @db.Text
  authorizedBy     String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  authorizer User     @relation(fields: [authorizedBy], references: [id])

  @@map("stock_adjustments")
}

model StockTransfer {
  id              String   @id @default(uuid()) @db.Uuid
  transferNumber  String   @unique @db.VarChar(100)
  fromWarehouseId String   @db.Uuid
  toWarehouseId   String   @db.Uuid
  transferDate    DateTime @db.Timestamptz
  status          String   @default("COMPLETED") @db.VarChar(30)
  notes           String?  @db.Text
  createdBy       String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz

  fromWarehouse Warehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  creator       User                @relation(fields: [createdBy], references: [id])
  items         StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String  @id @default(uuid()) @db.Uuid
  stockTransferId String  @db.Uuid
  productId       String  @db.Uuid
  quantity        Decimal @db.Decimal(10, 3)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("stock_transfer_items")
}

// -------------------------------------------------------------
// Notifications, Audit Logs & System Settings
// -------------------------------------------------------------

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(255)
  message    String    @db.Text
  severity   String    @default("INFO") @db.VarChar(20)
  entityType String?   @db.VarChar(50)
  entityId   String?   @db.Uuid
  isRead     Boolean   @default(false)
  readAt     DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  timestamp       DateTime @default(now()) @db.Timestamptz
  userId          String?  @db.Uuid
  userName        String   @db.VarChar(100)
  userRole        String   @db.VarChar(50)
  action          String   @db.VarChar(100)
  module          String   @db.VarChar(50)
  entityId        String?  @db.Uuid
  entityReference String?  @db.VarChar(100)
  oldValues       Json?    @db.JsonB
  newValues       Json?    @db.JsonB
  reason          String?  @db.Text
  ipAddress       String?  @db.VarChar(45)

  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     Json     @db.JsonB
  group     String   @db.VarChar(50)
  updatedBy String?  @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}
