{
  "name": "sms-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @sms/api dev & pnpm --filter @sms/web dev",
    "dev:api": "pnpm --filter @sms/api dev",
    "dev:web": "pnpm --filter @sms/web dev",
    "build:api": "pnpm --filter @sms/api build",
    "build:web": "pnpm --filter @sms/web build",
    "build": "pnpm --filter @sms/api build && pnpm --filter @sms/web build",
    "lint:api": "pnpm --filter @sms/api lint",
    "lint:web": "pnpm --filter @sms/web lint",
    "lint": "pnpm --filter @sms/api lint && pnpm --filter @sms/web lint",
    "test:api": "pnpm --filter @sms/api test",
    "test:web": "pnpm --filter @sms/web test",
    "test": "pnpm --filter @sms/api test && pnpm --filter @sms/web test",
    "typecheck": "pnpm --filter @sms/api typecheck && pnpm --filter @sms/web typecheck"
  },
  "devDependencies": {}
}
