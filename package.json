{
  "name": "ims-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ims/api dev & pnpm --filter @ims/web dev",
    "dev:api": "pnpm --filter @ims/api dev",
    "dev:web": "pnpm --filter @ims/web dev",
    "build:api": "pnpm --filter @ims/api build",
    "build:web": "pnpm --filter @ims/web build",
    "build": "pnpm --filter @ims/api build && pnpm --filter @ims/web build",
    "lint:api": "pnpm --filter @ims/api lint",
    "lint:web": "pnpm --filter @ims/web lint",
    "lint": "pnpm --filter @ims/api lint && pnpm --filter @ims/web lint",
    "test:api": "pnpm --filter @ims/api test",
    "test:web": "pnpm --filter @ims/web test",
    "test": "pnpm --filter @ims/api test && pnpm --filter @ims/web test",
    "typecheck": "pnpm --filter @ims/api typecheck && pnpm --filter @ims/web typecheck"
  },
  "devDependencies": {}
}
